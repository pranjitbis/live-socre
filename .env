# Server Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Qvi6Wu9FmEsex2q
DB_NAME=cricket_scraper
DB_CONNECTION_LIMIT=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Scraper Configuration
SCRAPER_TIMEOUT=30000
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1000
MAX_CONCURRENT_SCRAPES=5
REQUEST_DELAY_MIN=1000
REQUEST_DELAY_MAX=3000

# Cache TTL (seconds)
CACHE_TTL_LIVE=5
CACHE_TTL_COMMENTARY=3
CACHE_TTL_FIXTURES=60
CACHE_TTL_POINTS=1800
CACHE_TTL_NEWS=1800
CACHE_TTL_MATCH=3600

# Proxy Configuration
PROXY_ENABLED=false
PROXY_REFRESH_INTERVAL=3600000
PROXY_SOURCES=https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/socks5.txt,https://raw.githubusercontent.com/roosterkid/openproxylist/main/SOCKS5_RAW.txt

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=7
LOG_DIR=logs

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000

# Browser Configuration
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=false
BROWSER_TIMEOUT=30000

# Security
JWT_SECRET=your_jwt_secret_key
API_KEY=your_api_key_for_internal_services